# Hugging Face Token (required if using private models or gated models)
HF_TOKEN=your_hugging_face_token_here

# Path to save/load the whisper model
# Default: whisper
WHISPER_MODEL_PATH=whisper

# Device to use for inference (e.g., 'cpu', 'cuda', 'npu')
# Default: None (auto-detects)
WHISPER_DEVICE=

# Backend to use for transcription
# Default: auto
WHISPER_BACKEND=auto

# Hugging Face model ID for Whisper
# Default: openai/whisper-small
WHISPER_HF_MODEL=openai/whisper-small
